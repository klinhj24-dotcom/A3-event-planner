# Copy to .env and fill in real values. .env is gitignored.

# Clerk secret key — server-side only, NEVER put in frontend code.
# Find it at: https://dashboard.clerk.com → your app → API Keys
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx

# Clerk webhook signing secret — verifies incoming user.created /
# user.updated / user.deleted events at /api/webhooks/clerk.
# Find it at: https://dashboard.clerk.com → your app → Webhooks →
# your endpoint → Signing Secret.
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
